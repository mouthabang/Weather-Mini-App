<view class="text-left border border-solid rounded-sm  p-1 border-black">
  <input class="textbase  w-full" 
  value="{{internalValue}}"
  type="{{inputType || 'text'}}" 
  onInput="onInput" placeholder="{{placeholder}}" />
</view>

<view class="text-left" a:if="{{ errorMessage }}">
    <text class="text-[#E60000] text-sm">{{errorMessage}}</text>
</view>